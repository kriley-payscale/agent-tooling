# Template for ~/.agent-tooling/credentials. Three readers parse it: api.mjs, the
# browser verifier's Playwright --secrets loader (dotenv) and the SQL skills' node --env-file.
# Single-quote values and use no backslash escapes; dotenv keeps backslashes literally.
# Leave a value containing ' unquoted.
# Copy this file outside the plugin, replace every replace-with- value,
# then on macOS/Linux run: chmod 600 ~/.agent-tooling/credentials
# Never commit credentials.

# Base URL of the locally running API
API_BASE_URL='replace-with-local-api-base-url'

# Admin pair (a user with the admin role)
ADMIN_EMAIL='replace-with-admin-email'
ADMIN_PASSWORD='replace-with-admin-password'

# Standard pair (a user without admin rights, for permission checks)
STANDARD_EMAIL='replace-with-standard-email'
STANDARD_PASSWORD='replace-with-standard-password'

# Local SQL Server login password for the SQL skills
SQL_PASSWORD='replace-with-sql-password'
